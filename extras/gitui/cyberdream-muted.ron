(
    selected_tab: Rgb(126, 216, 232), // bright cyan for highlight
    command_fg: Rgb(255, 255, 255), // white for commands foreground
    selection_bg: Rgb(60, 64, 72), // darker grey for selection background
    selection_fg: Rgb(255, 255, 255), // white for selected text
    cmdbar_bg: Rgb(22, 24, 26), // very dark grey almost black for command bar background
    cmdbar_extra_lines_bg: Rgb(22, 24, 26), // very dark grey almost black for extra lines in command bar
    disabled_fg: Rgb(123, 132, 150), // a soft grey for disabled elements, adjusted to fit the theme
    diff_line_add: Rgb(126, 224, 136), // vibrant green for added lines
    diff_line_delete: Rgb(232, 121, 111), // vibrant red for deleted lines
    diff_file_added: Rgb(227, 200, 117), // yellow for added files
    diff_file_removed: Rgb(232, 120, 168), // light red for removed files
    diff_file_moved: Rgb(176, 126, 232), // purple for moved files
    diff_file_modified: Rgb(120, 168, 232), // blue for modified files
    commit_hash: Rgb(215, 190, 243), // light purplish for commit hashes
    commit_time: Rgb(121, 150, 191), // greyish blue for commit time
    commit_author: Rgb(120, 168, 232), // soft blue for author
    danger_fg: Rgb(232, 121, 111), // vibrant red for danger
    push_gauge_bg: Rgb(120, 168, 232), // soft blue for push gauge background
    push_gauge_fg: Rgb(75, 100, 134), // dark blue for push gauge foreground
    tag_fg: Rgb(243, 187, 211), // light pastel pink for tags
    branch_fg: Rgb(125, 218, 203) // soft turquoise for branches
)
