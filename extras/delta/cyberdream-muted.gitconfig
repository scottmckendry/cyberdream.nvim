[delta "cyberdream"]
	blame-palette = "#2b2c2e #313436 #494d50 #61676b #798186"
	commit-decoration-style = "#7c8391" bold box ul
	dark = true
	file-decoration-style = "#7c8391"
	file-style = "#e5e5e5"
	hunk-header-decoration-style = "#7c8391" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#9196a1"
	hunk-header-style = file line-number syntax
	line-numbers-left-style = "#7c8391"
	line-numbers-minus-style = bold "#e57164"
	line-numbers-plus-style = bold "#64e570"
	line-numbers-right-style = "#7c8391"
	line-numbers-zero-style = "#7c8391"
	minus-emph-style = bold syntax "#754743"
	minus-style = syntax "#503938"
	plus-emph-style = bold syntax "#417648"
	plus-style = syntax "#36513b"
	map-styles = \
	  bold purple => syntax "#604277", \
	  bold blue   => syntax "#415877", \
	  bold cyan   => syntax "#417177", \
	  bold yellow => syntax "#717643"
	# Should match the name of the bat theme
	syntax-theme = cyberdream
